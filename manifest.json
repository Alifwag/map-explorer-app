{
  "name": "MapExplorer - GPS Navigation & Tracker",
  "short_name": "MapExplorer",
  "description": "Smart navigation app with realtime GPS tracking, activity detection, place exploration & offline maps",
  "start_url": "/?utm_source=pwa",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "background_color": "#1a1a2e",
  "theme_color": "#0066ff",
  "scope": "/",
  "lang": "id-ID",
  "dir": "ltr",
  "categories": ["navigation", "maps", "travel", "fitness", "lifestyle"],
  "screenshots": [
    {
      "src": "/screenshot-home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home screen with map"
    },
    {
      "src": "/screenshot-navigation.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Navigation mode"
    }
  ],
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/logo192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Navigate",
      "short_name": "Go",
      "description": "Start navigation",
      "url": "/?action=navigate",
      "icons": [{ "src": "/favicon-32x32.png", "sizes": "32x32" }]
    },
    {
      "name": "Track Activity",
      "short_name": "Track",
      "description": "Start activity tracking",
      "url": "/?action=track",
      "icons": [{ "src": "/favicon-32x32.png", "sizes": "32x32" }]
    },
    {
      "name": "Explore Nearby",
      "short_name": "Explore",
      "description": "Find places nearby",
      "url": "/?action=explore",
      "icons": [{ "src": "/favicon-32x32.png", "sizes": "32x32" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {},
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "geo",
      "url": "/?coords=%s"
    }
  ]
}
